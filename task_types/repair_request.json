{
  "name": "Tenant repair request",
  "trigger": "tenant reports something broken or unsafe in a property",
  "inputs": ["request_text", "property_record", "tenancy_record", "contractor_list"],
  "decision": ["book_contractor", "ask_for_details", "escalate"],
  "fields": {
    "urgency": {
      "type": "enum",
      "critical": true,
      "options": ["emergency", "urgent", "routine"]
    },
    "trade": {
      "type": "enum",
      "critical": true,
      "options": ["plumbing", "electrical", "heating", "general", "other"]
    },
    "contractor_id": {"type": "string", "critical": false}
  },
  "text_outputs": ["tenant_reply"],
  "allowed_actions": ["draft_reply", "set_status", "route"],
  "hard_rules": ["gas smell or carbon monoxide", "no heating or hot water in winter"],
  "alpha": 0.02,
  "min_cases": 150,
  "capture": {
    "decision_rules": [
      {"action": "status", "status": "contractor_booked", "decision": "book_contractor"},
      {"action": "reply", "decision": "ask_for_details"},
      {"action": "forward", "decision": "escalate"}
    ],
    "reply_text_output": "tenant_reply"
  },
  "follow_up_days": {"ask_for_details": 2},
  "tools": ["search_past_cases", "get_case", "lookup_record", "check_rule"],
  "lookups": [{"input": "property_record", "kind": "property"}],
  "required_steps": {"book_contractor": ["lookup_record"]},
  "insight_dimensions": [{"name": "trade", "source": "request_text"}],
  "kpis": [
    {"metric": "completed_by_newt", "label": "Requests finished by Newt"},
    {"metric": "median_hours_to_complete", "target": 8, "direction": "down", "label": "Hours to sort a request"},
    {"metric": "backlog_open", "target": 10, "direction": "down", "label": "Requests waiting"}
  ],
  "question_bank": [
    {"key": "emergency", "question": "What counts as an emergency here, and who do you call out of hours?"},
    {"key": "contractors", "question": "Which contractors do you prefer for each trade, and when do you avoid one?"},
    {"key": "photos", "question": "When do you ask the tenant for photos before booking anyone?"},
    {"key": "landlord_approval", "question": "Above what cost do you need the landlord's approval?"}
  ]
}
