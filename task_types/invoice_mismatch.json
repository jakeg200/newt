{
  "name": "Invoice mismatch under £5k",
  "trigger": "invoice where amount or lines differ from the PO",
  "inputs": ["invoice_text", "po_record", "supplier_history"],
  "decision": ["approve", "query_supplier", "escalate"],
  "fields": {
    "variance_reason": {
      "type": "enum",
      "critical": true,
      "options": ["price", "quantity", "missing_po", "duplicate", "other"]
    },
    "gl_code": {"type": "string", "critical": true},
    "note": {"type": "text", "critical": false}
  },
  "text_outputs": ["supplier_email"],
  "allowed_actions": ["draft_reply", "set_status"],
  "hard_rules": ["amount above 5000 GBP", "supplier marked key account"],
  "alpha": 0.02,
  "min_cases": 150,
  "capture": {
    "decision_rules": [
      {"action": "label", "label": "Approved", "decision": "approve"},
      {"action": "status", "status": "approved", "decision": "approve"},
      {"action": "reply", "decision": "query_supplier"},
      {"action": "forward", "decision": "escalate"}
    ],
    "reply_text_output": "supplier_email"
  },
  "follow_up_days": {"query_supplier": 3},
  "tools": ["search_past_cases", "get_case", "lookup_record", "check_rule", "calculate"],
  "lookups": [{"input": "po_record", "kind": "purchase_order"}],
  "required_steps": {"approve": ["lookup_record"]},
  "insight_dimensions": [{"name": "supplier", "source": "subject", "pattern": "^(.+?) invoice"}],
  "kpis": [
    {"metric": "completed_by_newt", "label": "Invoices finished by Newt"},
    {"metric": "share_by_newt", "target": 0.5, "label": "Share of invoices Newt finished"},
    {"metric": "median_hours_to_complete", "target": 24, "direction": "down", "label": "Hours to clear an invoice"},
    {"metric": "hours_returned", "label": "Hours given back"}
  ],
  "question_bank": [
    {"key": "tolerance", "question": "How big a price difference do you let through without querying the supplier?"},
    {"key": "key_accounts", "question": "Which suppliers are key accounts, and what do you do differently for them?"},
    {"key": "duplicates", "question": "How do you spot a duplicate invoice, and what do you check first?"},
    {"key": "gl_codes", "question": "Which GL codes do people most often get wrong, and how do you choose?"},
    {"key": "chasing", "question": "When a supplier doesn't reply to a query, when and how do you chase them?"}
  ]
}
